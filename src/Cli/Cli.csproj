<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProbabilityAudit</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>probability-audit</ToolCommandName>
    <PackageId>ProbabilityAudit.Tool</PackageId>
    <Version>0.1.0</Version>
    <Authors>alirezaRanjbar4</Authors>
    <Description>Offline binary probability reliability bins and Brier scoring for labeled model predictions.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/alirezaRanjbar4/probability-audit</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alirezaRanjbar4/probability-audit</PackageProjectUrl>
    <PackageTags>csharp;dotnet;machine-learning;calibration;classification;evaluation</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md;../../LICENSE;../../CONTRIBUTING.md;../../ROADMAP.md;../../CHANGELOG.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/*.md" Pack="true" PackagePath="docs/" />
    <None Include="../../examples/*.jsonl;../../examples/*.md" Pack="true" PackagePath="examples/" />
    <None Include="../../.github/workflows/ci.yml" Pack="true" PackagePath=".github/workflows/" />
  </ItemGroup>
</Project>
